# App
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
APP_NAME="Bendel Insurance"
ADMIN_EMAIL=admin@bendelinsurancefc.com

# Database (Render Postgres)
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME?sslmode=require
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER="bendel-insurance"

# Squad API (payments / ticketing / merchandise)
SQUAD_API_BASE_URL=
SQUAD_API_KEY=
SQUAD_SECRET_KEY=
SQUAD_WEBHOOK_SECRET=
SQUAD_ENVIRONMENT=sandbox

# Email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Bendel Insurance <noreply@bendelinsurancefc.com>"
RESEND_API_KEY=

# Auth / sessions
JWT_SECRET=
SESSION_SECRET=

# Optional: Live scores / fixtures integration
LIVESCORE_API_BASE_URL=
LIVESCORE_API_KEY=
LIVESCORE_API_TOKEN=

# Storage / uploads
UPLOAD_DIR=./storage/uploads

# Admin credentials (temporary placeholders)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
